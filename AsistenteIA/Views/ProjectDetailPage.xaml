<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AsistenteIA.Models"
             x:Class="AsistenteIA.Views.ProjectDetailPage"
             x:Name="Root"
             Title="{Binding PageTitle}">
    <ScrollView>
        <Grid Padding="20" MaximumWidthRequest="{StaticResource ContentMaxWidth}" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="12">
                <Label Text="Datos del proyecto" Style="{StaticResource Title}"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="Nombre" Style="{StaticResource Muted}" />
                <Entry Text="{Binding Name}" Placeholder="Ej. Cálculo II, Proyecto de grado..."
                       MaxLength="{Binding NameMaxLength}"
                       SemanticProperties.Description="Nombre del proyecto" />

                <Label Text="Descripción (opcional)" Style="{StaticResource Muted}" />
                <Border Style="{StaticResource Card}" Padding="8" BackgroundColor="{StaticResource SurfaceAlt}">
                    <Editor Text="{Binding Description}"
                            Placeholder="De qué trata el proyecto; la IA usará esto como contexto"
                            MaxLength="{Binding DescriptionMaxLength}"
                            AutoSize="TextChanges" MinimumHeightRequest="90"
                            SemanticProperties.Description="Descripción del proyecto" />
                </Border>

                <Button Text="Guardar proyecto" Command="{Binding SaveCommand}"
                        SemanticProperties.Hint="Crea o actualiza el proyecto" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Muted}"
                       SemanticProperties.Description="Estado de la operación" />

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsExisting}">
                    <Button Text="Consultar en este proyecto" Style="{StaticResource SecondaryButton}"
                            Command="{Binding StartConsultationCommand}"
                            SemanticProperties.Hint="Abre la pantalla de consulta con este proyecto seleccionado" />

                    <Label Text="Consultas del proyecto" Style="{StaticResource Subtitle}" Margin="0,10,0,0"
                           SemanticProperties.HeadingLevel="Level2" />

                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Conversations}">
                        <BindableLayout.EmptyView>
                            <Label Text="Aún no hay consultas en este proyecto." Style="{StaticResource Muted}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ConversationRecord">
                                <Border Style="{StaticResource Card}" SemanticProperties.Hint="Abre el detalle de la consulta">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenConversationCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Prompt}" FontFamily="OpenSansSemibold"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding MetaText}" Style="{StaticResource Meta}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Eliminar proyecto" Style="{StaticResource DangerButton}" Margin="0,16,0,0"
                            Command="{Binding DeleteCommand}"
                            SemanticProperties.Hint="Elimina el proyecto; sus consultas se conservan" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
