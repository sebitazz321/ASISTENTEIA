<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsistenteIA.Views.DetailPage"
             Title="Detalle">
    <ScrollView>
        <Grid Padding="20" MaximumWidthRequest="{StaticResource ContentMaxWidth}" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="10">
                <Label Text="Consulta" Style="{StaticResource Subtitle}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}"><Label Text="{Binding Prompt}" /></Border>

                <Label Text="Respuesta" Style="{StaticResource Subtitle}" Margin="0,10,0,0"
                       SemanticProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}"><Label Text="{Binding Answer}" LineBreakMode="WordWrap" /></Border>

                <BoxView HeightRequest="1" Margin="0,10" />

                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Fecha: " FontAttributes="Bold" />
                            <Span Text="{Binding CreatedAtText}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Categoría: " FontAttributes="Bold" />
                            <Span Text="{Binding Category}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Proyecto: " FontAttributes="Bold" />
                            <Span Text="{Binding ProjectName}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding VerificationText}" Style="{StaticResource Muted}" FontAttributes="Italic" />

                <Label Text="Nota personal" Style="{StaticResource Subtitle}" Margin="0,10,0,0"
                       SemanticProperties.HeadingLevel="Level2" />
                <Border Style="{StaticResource Card}" Padding="8" BackgroundColor="{StaticResource SurfaceAlt}">
                    <Editor Text="{Binding Note}"
                            Placeholder="Escriba una nota (fuente consultada, dudas, resumen propio...)"
                            MaxLength="{Binding NoteMaxLength}"
                            AutoSize="TextChanges" MinimumHeightRequest="80"
                            SemanticProperties.Description="Nota personal sobre la respuesta" />
                </Border>
                <Button Text="Guardar nota" Command="{Binding SaveNoteCommand}" Style="{StaticResource SecondaryButton}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Muted}"
                       SemanticProperties.Description="Estado de la operación" />

                <Button Text="{Binding VerifyButtonText}"
                        Command="{Binding ToggleVerifiedCommand}" Style="{StaticResource SuccessButton}" Margin="0,10,0,0" />
                <Button Text="Eliminar consulta"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource DangerButton}" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
