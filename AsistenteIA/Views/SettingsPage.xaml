<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsistenteIA.Views.SettingsPage"
             Title="Configuración">
    <ScrollView>
        <Grid Padding="20" MaximumWidthRequest="{StaticResource ContentMaxWidth}" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="12">
            <Label Text="Configuración de la API"
                   Style="{StaticResource Title}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Border Style="{StaticResource WarningCard}">
                <Label Text="AVISO DE PRIVACIDAD: no ingrese datos personales, contraseñas, información confidencial ni documentos institucionales sensibles en sus consultas."
                       TextColor="{StaticResource WarningText}" FontSize="12" FontFamily="OpenSansSemibold" />
            </Border>

            <Label Text="Clave de API" Style="{StaticResource Subtitle}" />
            <Label Text="{Binding KeyStatus}" Style="{StaticResource Muted}" />
            <Entry Text="{Binding ApiKey}" IsPassword="True"
                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                   Placeholder="Escriba aquí una clave nueva"
                   SemanticProperties.Description="Campo para la clave de la API, oculto" />

            <Label Text="Modelo de IA" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
            <Picker Title="Modelos sugeridos"
                    ItemsSource="{Binding SuggestedModels}"
                    SelectedItem="{Binding SelectedModel}" />
            <Entry Text="{Binding SelectedModel}" Placeholder="Identificador del modelo"
                   SemanticProperties.Description="Identificador del modelo de IA" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <Button Text="Guardar" Command="{Binding SaveKeyCommand}" />
                <Button Grid.Column="1" Text="Probar conexión"
                        Command="{Binding TestConnectionCommand}"
                        Style="{StaticResource SuccessButton}" />
            </Grid>
            <Button Text="Eliminar clave" Command="{Binding RemoveKeyCommand}"
                    Style="{StaticResource DangerButton}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource Muted}" FontSize="13"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1" Margin="0,10" />

            <Label Text="Acerca de" Style="{StaticResource Title}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Finalidad" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
            <Label Text="AsistenteIA es una aplicación académica que envía consultas a un modelo de IA mediante una API REST, muestra la respuesta y guarda un historial local para estudio." />

            <Label Text="Autoría" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
            <Label Text="Proyecto final de Programación Avanzada y Aplicada, VI semestre, Tecnología de Desarrollo de Software. Integrantes: [escriba aquí los nombres del equipo]." />

            <Label Text="Fuentes técnicas" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
            <Label Text="Microsoft Learn (.NET MAUI, HttpClient, inyección de dependencias) y documentación de la API de Google Gemini." />

            <Label Text="Privacidad" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
            <Label Text="La clave se guarda en el almacén seguro del dispositivo (SecureStorage). El historial se guarda solo en este dispositivo (SQLite). El texto de cada consulta se envía al proveedor de IA para generar la respuesta." />

            <Label Text="Límites del uso de IA" Style="{StaticResource Subtitle}" Margin="0,6,0,0" />
            <Label Text="La IA puede dar respuestas incorrectas, incompletas o inventadas. No es una autoridad: contraste la información con fuentes confiables y use la marca «verificada» solo después de hacerlo." />
        </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
