<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsistenteIA.Views.SettingsPage"
             Title="Configuración">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Configuración de Credenciales"
                   FontSize="22" FontAttributes="Bold" />

            <!-- Advertencia de Seguridad y Uso Responsable -->
            <Frame BackgroundColor="#FFF8E1" BorderColor="#FFA000" Padding="12">
                <Label Text="⚠️ AVISO DE PRIVACIDAD: No ingrese datos personales, contraseñas, información confidencial ni documentos institucionales en los prompts."
                       TextColor="#B71C1C" FontSize="12" FontAttributes="Bold" />
            </Frame>

            <!-- Clave API -->
            <Label Text="Clave de API:" FontAttributes="Bold" />
            <Entry Text="{Binding ApiKey}"
                   IsPassword="True"
                   Placeholder="Ingrese la clave autorizada" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <Button Text="Guardar Clave" Command="{Binding SaveKeyCommand}" />
                <Button Grid.Column="1" Text="Probar Conexión"
                        Command="{Binding TestConnectionCommand}"
                        BackgroundColor="#2E7D32" TextColor="White" />
            </Grid>

            <Button Text="Eliminar Clave"
                    Command="{Binding RemoveKeyCommand}"
                    BackgroundColor="DarkRed" TextColor="White" Margin="0,5,0,0" />

            <!-- Selector de Modelo -->
            <Label Text="Modelo de IA:" FontAttributes="Bold" Margin="0,10,0,0" />
            <Entry Text="{Binding SelectedModel}" Placeholder="Ej: openai/gpt-5.4-nano" />

            <!-- Estado -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>