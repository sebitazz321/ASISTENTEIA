<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsistenteIA.Views.ProfilePage"
             Title="Perfil">
    <ScrollView>
        <Grid Padding="20" MaximumWidthRequest="{StaticResource ContentMaxWidth}" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="14">

                <Border Style="{StaticResource Avatar}" SemanticProperties.Description="Avatar con sus iniciales">
                    <Label Text="{Binding Initials}" FontSize="34" FontFamily="OpenSansSemibold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Mi perfil" Style="{StaticResource Title}" HorizontalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />

                <!-- Estadísticas -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource Card}" Padding="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding TotalConsultations}" Style="{StaticResource StatNumber}" />
                            <Label Text="Consultas" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding VerifiedConsultations}" Style="{StaticResource StatNumber}" />
                            <Label Text="Verificadas" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding ProjectCount}" Style="{StaticResource StatNumber}" />
                            <Label Text="Proyectos" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Datos personales" Style="{StaticResource Subtitle}" Margin="0,6,0,0"
                       SemanticProperties.HeadingLevel="Level2" />
                <Label Text="Se guardan solo en este dispositivo; no se envían a la IA." Style="{StaticResource Muted}" />

                <Label Text="Nombre" Style="{StaticResource Muted}" />
                <Entry Text="{Binding Name}" Placeholder="Su nombre" MaxLength="{Binding FieldMaxLength}"
                       SemanticProperties.Description="Nombre del estudiante" />
                <Label Text="Programa o carrera" Style="{StaticResource Muted}" />
                <Entry Text="{Binding Program}" Placeholder="Ej. Tecnología en Desarrollo de Software"
                       MaxLength="{Binding FieldMaxLength}"
                       SemanticProperties.Description="Programa o carrera" />
                <Label Text="Institución" Style="{StaticResource Muted}" />
                <Entry Text="{Binding Institution}" Placeholder="Su institución"
                       MaxLength="{Binding FieldMaxLength}"
                       SemanticProperties.Description="Institución educativa" />

                <Button Text="Guardar perfil" Command="{Binding SaveProfileCommand}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Muted}"
                       SemanticProperties.Description="Estado de la operación" />

                <BoxView HeightRequest="1" Margin="0,6" />

                <Label Text="Aplicación y privacidad" Style="{StaticResource Subtitle}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Button Text="Configuración, clave de API y Acerca de" Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenSettingsCommand}" />
                <Button Text="Borrar historial de consultas" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearHistoryCommand}" />
                <Button Text="Borrar todos mis datos locales" Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteAllDataCommand}"
                        SemanticProperties.Hint="Elimina consultas, proyectos y perfil de este dispositivo" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
