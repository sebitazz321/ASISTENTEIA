<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AsistenteIA.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AsistenteIA.Views"
    Title="AsistenteIA">

    <!-- Cinco pestañas principales. Configuración, Detalle y Detalle de proyecto
         son rutas secundarias (se abren desde Perfil, Historial y Proyectos). -->
    <TabBar>
        <ShellContent Title="Inicio" Route="HomePage" ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Consultar" Route="ChatPage" ContentTemplate="{DataTemplate views:ChatPage}" />
        <ShellContent Title="Proyectos" Route="ProjectsPage" ContentTemplate="{DataTemplate views:ProjectsPage}" />
        <ShellContent Title="Historial" Route="HistoryPage" ContentTemplate="{DataTemplate views:HistoryPage}" />
        <ShellContent Title="Perfil" Route="ProfilePage" ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>
