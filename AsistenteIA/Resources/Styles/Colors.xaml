<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta "Grafito": escala de grises neutros.
         Contraste mínimo 4.5:1 en texto sobre fondos (WCAG AA). -->
    <Color x:Key="Background">#121214</Color>
    <Color x:Key="Surface">#1C1C1F</Color>
    <Color x:Key="SurfaceAlt">#27272B</Color>
    <Color x:Key="Outline">#3A3A40</Color>

    <Color x:Key="Primary">#E4E4E7</Color>
    <Color x:Key="PrimaryDark">#B4B4BB</Color>
    <Color x:Key="OnPrimary">#141416</Color>
    <Color x:Key="Accent">#C4C4CB</Color>

    <Color x:Key="TextPrimary">#F4F4F5</Color>
    <Color x:Key="TextMuted">#A1A1AA</Color>

    <!-- Colores semánticos apagados (siempre acompañados de texto, nunca solo color). -->
    <Color x:Key="Danger">#A94442</Color>
    <Color x:Key="Success">#3F7A55</Color>
    <Color x:Key="WarningBg">#26241F</Color>
    <Color x:Key="WarningText">#D8CFA8</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3F3F46" Offset="0.0" />
        <GradientStop Color="#1F1F23" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
